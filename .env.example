# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------

# Base URL of the backend API (Vite reads VITE_* at build time).
VITE_API_URL=http://localhost:8080/api

# ----------------------------------------------------------------------------
# Backend — Authentication
# ----------------------------------------------------------------------------

# HMAC-SHA256 signing key for JWT access tokens. At least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Token lifetimes (Spring Duration format: 15m, 12h, 14d).
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d

# Set to true when the API is served over HTTPS (marks the refresh cookie Secure).
COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# Google Sign-In
# ----------------------------------------------------------------------------

# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Backend verifies ID tokens against this audience; frontend renders the button with it.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# The client SECRET is needed only by Google Drive backup, which runs the
# authorization-code flow for offline access. Google Sign-In does not use it.
GOOGLE_CLIENT_SECRET=

# Where Google returns the authorization code. Must match the "Authorized redirect
# URI" on the same OAuth client, character for character, or the exchange fails
# with redirect_uri_mismatch.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5173/settings/google-drive/callback

# ----------------------------------------------------------------------------
# Email (verification + password reset)
# ----------------------------------------------------------------------------

# Master switch. false (the local-profile default) logs each message — verification
# and reset links included — instead of sending it, so no SMTP server is needed.
# Only ever disable in local development: tokens end up in the log.
#
# To send for real locally:
#   docker compose -f infra/compose.yaml up -d mailpit
#   MAIL_ENABLED=true   (inbox at http://localhost:8025)
MAIL_ENABLED=false

# Production SMTP goes through Spring relaxed binding:
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Sender address and the base URL used in emailed links.
MAIL_FROM=noreply@personal-finance.local
FRONTEND_BASE_URL=http://localhost:5173

# One-time token lifetimes.
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

# ----------------------------------------------------------------------------
# Default development user
# ----------------------------------------------------------------------------

# Seeds a pre-verified account on startup so a fresh database can be logged
# into without registering. On by default in the local profile only —
# a known password must never exist in a deployed environment.
DEFAULT_USER_ENABLED=true
DEFAULT_USER_EMAIL=owner@personal-finance.local
DEFAULT_USER_PASSWORD=password123
DEFAULT_USER_NAME=Default Owner

# ----------------------------------------------------------------------------
# Backup & Restore
# ----------------------------------------------------------------------------

# Schedule for automatic backups, as a Spring cron expression. Spring reads this
# once at startup; the AUTO_BACKUP_ENABLED setting decides whether a run does
# anything and takes effect immediately. Default is 02:00 daily.
AUTO_BACKUP_CRON=0 0 2 * * *

# AES key protecting third-party credentials held at rest — currently only the
# Google Drive refresh token, which must be replayable and so cannot be hashed.
# Optional: without it the app runs normally and only Drive backup is
# unavailable. At least 32 bytes.
# Generate one with: openssl rand -base64 48
ENCRYPTION_SECRET=

# Only needed for the PG_DUMP backup format, which shells out to the PostgreSQL
# client tools. Absolute paths if they are not on PATH. The JSON format needs
# no external tools.
PG_DUMP_PATH=pg_dump
PG_RESTORE_PATH=pg_restore
PG_TOOL_TIMEOUT=10m

# Largest archive accepted by the restore-from-upload endpoint.
MAX_BACKUP_UPLOAD_SIZE=256MB

# ----------------------------------------------------------------------------
# scripts/backup.sh and scripts/restore.sh
# ----------------------------------------------------------------------------

# The scripts drive the REST API, so they sign in like any other client.
API_BASE_URL=http://localhost:8080/api
API_EMAIL=owner@personal-finance.local
API_PASSWORD=password123
