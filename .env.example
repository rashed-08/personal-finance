# ----------------------------------------------------------------------------
# Frontend
# ----------------------------------------------------------------------------

# Base URL of the backend API (Vite reads VITE_* at build time).
VITE_API_URL=http://localhost:8080/api

# ----------------------------------------------------------------------------
# Backend — Authentication
# ----------------------------------------------------------------------------

# HMAC-SHA256 signing key for JWT access tokens. At least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Token lifetimes (Spring Duration format: 15m, 12h, 14d).
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d

# Set to true when the API is served over HTTPS (marks the refresh cookie Secure).
COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# Google Sign-In
# ----------------------------------------------------------------------------

# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Backend verifies ID tokens against this audience; frontend renders the button with it.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ----------------------------------------------------------------------------
# Email (verification + password reset)
# ----------------------------------------------------------------------------

# Local development uses Mailpit from infra/compose.yaml (host localhost, port 1025,
# web UI http://localhost:8025) — configured in application-local.yml.
# Production SMTP goes through Spring relaxed binding:
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Sender address and the base URL used in emailed links.
MAIL_FROM=noreply@personal-finance.local
FRONTEND_BASE_URL=http://localhost:5173

# One-time token lifetimes.
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h
