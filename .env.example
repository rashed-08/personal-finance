# ----------------------------------------------------------------------------
# Backend — Authentication
# ----------------------------------------------------------------------------

# HMAC-SHA256 signing key for JWT access tokens. At least 32 bytes.
# Generate one with: openssl rand -base64 48
JWT_SECRET=

# Token lifetimes (Spring Duration format: 15m, 12h, 14d).
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=14d

# Set to true when the API is served over HTTPS (marks the refresh cookie Secure).
COOKIE_SECURE=false

# ----------------------------------------------------------------------------
# Google Sign-In
# ----------------------------------------------------------------------------

# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Backend verifies ID tokens against this audience; frontend renders the button with it.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
